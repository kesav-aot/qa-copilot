#!/bin/sh
# QA Copilot launcher — turns a machine with no Python toolchain into one that
# can run the test executor, without anybody opening a terminal.
#
# It serves two installations from one script:
#   * the Claude Desktop extension (.mcpb), where the package sits in src/ and
#     the starting config in config-defaults/;
#   * the Claude Code plugin installed from GitHub, where the checkout root is
#     the package and .venv/ is (correctly) not in the repository.
#
# Claude speaks MCP to this process over stdin/stdout, so STDOUT IS THE PROTOCOL
# CHANNEL. Every diagnostic goes to stderr; a stray echo corrupts the stream and
# surfaces as an unhelpful parse error.
#
# Each stage is idempotent and leaves a marker, so an interrupted first run — a
# host gives a server a limited window to start — resumes rather than restarts.

set -eu

log() { printf 'qa-copilot: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

# A host leaves ${user_config.x} unsubstituted when the field is blank. Treat a
# leftover placeholder as "not set" rather than as a literal value.
clean() {
    case "${1:-}" in
        *'${'*) printf '' ;;
        *) printf '%s' "${1:-}" ;;
    esac
}

ROOT=$(clean "${QA_COPILOT_BUNDLE:-}")
[ -n "$ROOT" ] || ROOT=$(clean "${CLAUDE_PLUGIN_ROOT:-}")
if [ -z "$ROOT" ]; then
    ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
    # In a source checkout the launcher lives at packaging/launcher/, so the
    # project root is one level further up than it is inside a bundle.
    [ -f "$ROOT/pyproject.toml" ] || [ -d "$ROOT/src" ] \
        || ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd)
fi

# --- which layout are we in? ------------------------------------------------
if [ -d "$ROOT/src" ] && [ -f "$ROOT/src/pyproject.toml" ]; then
    SRC="$ROOT/src"                       # packaged bundle
elif [ -f "$ROOT/pyproject.toml" ]; then
    SRC="$ROOT"                           # source checkout / cloned plugin
else
    die "cannot find the QA Copilot package under $ROOT"
fi

# config/ at the root of a checkout is a *working* configuration — whoever
# develops QA Copilot points it at their own applications. Shipping that to
# everyone who installs the plugin means they open the setup page and are asked
# about half a dozen accounts that are nothing to do with them.
if [ -d "$ROOT/config-defaults" ]; then
    DEFAULTS="$ROOT/config-defaults"                # packaged bundle
elif [ -d "$ROOT/packaging/config-defaults" ]; then
    DEFAULTS="$ROOT/packaging/config-defaults"      # checkout / cloned plugin
else
    DEFAULTS="$ROOT/config"
fi

if [ -f "$ROOT/VERSION" ]; then
    VERSION=$(cat "$ROOT/VERSION")
else
    # Good enough to decide "has the code changed since we installed it": a
    # release bumps this, and a bundle carries an explicit VERSION file anyway.
    VERSION=$(sed -n 's/^version *= *"\(.*\)"/\1/p' "$SRC/pyproject.toml" | head -1)
    [ -n "$VERSION" ] || VERSION=dev
fi

HOME_DIR=$(clean "${QA_COPILOT_HOME:-}")
[ -n "$HOME_DIR" ] || HOME_DIR="$HOME/.qa-copilot"
mkdir -p "$HOME_DIR"

RUNTIME="$HOME_DIR/runtime"
VENV="$RUNTIME/venv"
PY="$VENV/bin/python"
STAMP="$RUNTIME/installed-version"

# --- 0. one provisioner at a time -------------------------------------------
# A host may start a second server while the first is still setting itself up —
# on an upgrade, both then run `uv pip install` into the same virtualenv, and
# whichever reaches `exec` while the other is rewriting the console script finds
# no file to run and exits without a word. mkdir is atomic, so it is the lock.
LOCK="$RUNTIME/setup.lock"
mkdir -p "$RUNTIME"
have_lock=no
i=0
while [ $i -lt 300 ]; do                       # up to five minutes
    if mkdir "$LOCK" 2>/dev/null; then
        have_lock=yes
        break
    fi
    # A lock left by a process that died is not a reason to wait forever.
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
        log "clearing a stale setup lock"
        rmdir "$LOCK" 2>/dev/null || true
        continue
    fi
    [ $i -eq 0 ] && log "another QA Copilot is setting up; waiting for it"
    sleep 1
    i=$((i + 1))
done
release_lock() { [ "$have_lock" = yes ] && rmdir "$LOCK" 2>/dev/null || true; }
trap release_lock EXIT INT TERM

# --- 1. uv ------------------------------------------------------------------
# uv provisions its own CPython, which is the point: the Python that ships with
# macOS is 3.9 and this package needs 3.11+. Asking a QA engineer to fix that by
# hand is exactly the barrier this launcher exists to remove.
#
# Where the installer drops the binary has moved between uv releases, so look in
# both places rather than pinning one and breaking on the next release.
find_uv() {
    for candidate in "$RUNTIME/bin/uv" "$RUNTIME/uv"; do
        if [ -x "$candidate" ]; then printf '%s' "$candidate"; return 0; fi
    done
    command -v uv 2>/dev/null || true
}

UV=$(find_uv)
if [ -z "$UV" ]; then
    log "first run: fetching the uv runtime installer (a few seconds)"
    mkdir -p "$RUNTIME/bin"
    command -v curl >/dev/null 2>&1 \
        || die "curl is required for first-time setup and was not found."
    UV_UNMANAGED_INSTALL="$RUNTIME/bin" \
        sh -c "$(curl -LsSf https://astral.sh/uv/install.sh)" >&2 \
        || die "could not install uv. Check your network or proxy settings."
    UV=$(find_uv)
    [ -n "$UV" ] || die "uv did not install under $RUNTIME"
fi

# --- 2. interpreter + dependencies -----------------------------------------
if [ ! -x "$PY" ]; then
    log "first run: preparing a private Python 3.12 (about a minute)"
    "$UV" venv --python 3.12 "$VENV" >&2 || die "could not create the Python environment"
fi

if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$VERSION" ]; then
    log "installing QA Copilot $VERSION"
    "$UV" pip install --python "$PY" --quiet "$SRC" >&2 \
        || die "could not install QA Copilot's dependencies"
    printf '%s' "$VERSION" > "$STAMP"
fi

# --- 3. workspace -----------------------------------------------------------
# A host that already decided where config lives (the Claude Code plugin points
# at its own checkout) wins. Otherwise config goes in the workspace and never in
# the bundle, which is replaced wholesale on upgrade and would take the QA
# engineer's accounts with it.
if [ -z "$(clean "${QA_COPILOT_CONFIG:-}")" ]; then
    QA_COPILOT_CONFIG="$HOME_DIR/config"
    if [ ! -d "$QA_COPILOT_CONFIG" ]; then
        log "creating your workspace at $HOME_DIR"
        cp -R "$DEFAULTS" "$QA_COPILOT_CONFIG"
    fi
fi
[ -n "$(clean "${QA_COPILOT_STATE:-}")" ] || QA_COPILOT_STATE="$HOME_DIR/state"
mkdir -p "$QA_COPILOT_STATE" "$HOME_DIR/tests" "$HOME_DIR/artifacts"

export QA_COPILOT_CONFIG QA_COPILOT_STATE
export QA_COPILOT_HOME="$HOME_DIR"

# --- 4. point it at the QA engineer's app ----------------------------------
# Only when they filled the settings in, and only once per environment. This is
# the stage that needs a browser, so it is also the slow one.
APP_URL=$(clean "${QA_COPILOT_APP_URL:-}")
ENV_NAME=$(clean "${QA_COPILOT_ENV_NAME:-}")
[ -n "$ENV_NAME" ] || ENV_NAME="local"
PROVISIONED="$RUNTIME/provisioned-$ENV_NAME"

if [ -n "$APP_URL" ] && [ ! -f "$PROVISIONED" ]; then
    if [ ! -d "${PLAYWRIGHT_BROWSERS_PATH:-$HOME/Library/Caches/ms-playwright}" ]; then
        log "first run: downloading the test browser (about 500 MB, one time)"
    fi
    "$PY" -m playwright install chromium >&2 \
        || log "the browser download did not finish; it will be retried next time"
    log "looking at $APP_URL to find its sign-in form"
    if [ -f "$ROOT/bootstrap/provision.py" ]; then
        PROVISION="$ROOT/bootstrap/provision.py"
    else
        PROVISION="$ROOT/packaging/mcpb/bootstrap/provision.py"
    fi
    if "$PY" "$PROVISION" >&2; then
        : > "$PROVISIONED"
        log "ready: environment '$ENV_NAME' is configured"
    else
        log "could not finish setup for '$ENV_NAME' — the tools still work against"
        log "the demo app. Fix the settings and restart."
    fi
fi

# --- 5. the test browser ----------------------------------------------------
# Only the provisioning branch above used to fetch this, so an install that
# never provisioned — the Claude Code plugin, or anyone who filled the setup
# page instead — reached its first real browser step with no browser at all.
# Fetch it in the background so startup is not held up by 500 MB.
# Unconditionally, and never guarded by whether the cache directory exists.
# Playwright pins one browser build per version, so a directory left behind by a
# different version — or by a download that was interrupted — contains nothing
# this code can launch. Checking only for the directory meant the download was
# then skipped forever, and every test failed with Playwright's own message
# telling the reader to run a terminal command.
#
# When the right build is already present this exits in about a second.
BROWSER_LOG="$HOME_DIR/browser-install.log"
BROWSER_STAMP="$RUNTIME/browser-verified-$VERSION"
if [ ! -f "$BROWSER_STAMP" ]; then
    log "checking the test browser (first time: about 500 MB, in the background)"
    # nohup and a full detach: this outlives the shell, and nothing about the
    # server's lifetime depends on it. A missing browser is repaired on demand
    # by the executor as well, so this is a head start, not a prerequisite.
    nohup sh -c "\"$PY\" -m playwright install chromium >\"$BROWSER_LOG\" 2>&1 \
        && : > \"$BROWSER_STAMP\"" >/dev/null 2>&1 &
fi

# --- 6. serve ---------------------------------------------------------------
SERVER="$VENV/bin/qa-copilot-mcp"
if [ ! -x "$SERVER" ]; then
    # Exec-ing a missing file exits the shell silently, and the host can only
    # report "the process exited early" with no cause.
    die "the server is missing at $SERVER. The install did not complete; see $BROWSER_LOG and try again."
fi
release_lock
trap - EXIT INT TERM
exec "$SERVER"
