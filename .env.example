# Copy to .env. Never commit the real file.
# secret://demo/admin/password  ->  QA_SECRET__DEMO__ADMIN__PASSWORD
#
# These are the demo application's throwaway credentials. Everything the AI does
# with them goes through an alias; it never reads these values.

QA_SECRET__DEMO__ADMIN__USERNAME=admin@qa.local
QA_SECRET__DEMO__ADMIN__PASSWORD=Adm1n-Demo-Pass!
QA_SECRET__DEMO__USER__USERNAME=user@qa.local
QA_SECRET__DEMO__USER__PASSWORD=Us3r-Demo-Pass!
